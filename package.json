{
  "name": "content-pipeline-skeleton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static Astro blog built only from Markdown content files; drafts are generated for human review.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:py": "python -m pytest",
    "test:all": "npm run test && npm run test:py"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
