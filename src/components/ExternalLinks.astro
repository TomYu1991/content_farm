---
/**
 * A titled list of the maker's own external links ("Support my work",
 * "Get the pattern"). Renders nothing when `links` is empty.
 */
import { MONETIZATION_TEXT as T, type ExternalLink } from '../lib/monetization';

interface Props {
  id: string;
  heading: string;
  lead?: string;
  links: readonly ExternalLink[];
  /** Heading level inside the page outline. */
  level?: 2 | 3;
}

const { id, heading, lead, links, level = 2 } = Astro.props;
const Heading = `h${level}` as const;
---
{
  links.length > 0 && (
    <section class="link-block" lang={T.lang} aria-labelledby={id}>
      <Heading id={id}>{heading}</Heading>
      {lead && <p>{lead}</p>}
      <ul class="link-block__list">
        {links.map((link) => (
          <li>
            <a class="link-button" href={link.url}>{link.label}</a>
          </li>
        ))}
      </ul>
    </section>
  )
}
