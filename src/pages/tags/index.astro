---
// Tag index: every tag used by published works and articles, with counts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProductionArticles } from '../../lib/articles';
import { groupByTag } from '../../lib/listing';
import { getProductionWorks } from '../../lib/works';

const [articles, works] = await Promise.all([getProductionArticles(), getProductionWorks()]);
const groups = groupByTag([...articles, ...works]);
---
<BaseLayout title="标签" description="按标签浏览作品与文章。">
  <h1>标签</h1>
  {
    groups.length === 0 ? (
      <p class="empty-state">暂无标签。</p>
    ) : (
      <ul class="tag-list tag-list--index" aria-label="全部标签">
        {groups.map((group) => (
          <li>
            <a class="tag-link" href={group.path}>
              #{group.label} <span class="tag-count">（{group.articles.length}）</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
